{
  "expo": {
    "name": "TrueDial",
    "slug": "truedial-mobile",
    "owner": "tanuj007",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.truedial.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0a1c3a"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "truedial",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fc7f4cc-a79f-4fee-960c-2aba8f7d270b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8fc7f4cc-a79f-4fee-960c-2aba8f7d270b"
    }
  }
}
